# Firebase project settings (safe public identifiers, not private server secrets)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# OAuth Client ID (type: Web application), used to obtain Google ID tokens for Firebase
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Reverse-client-ID of an iOS OAuth app; enables Expo native Google Sign-In plugin
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
