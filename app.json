{
  "expo": {
    "name": "calmly",
    "slug": "calmly",
    "scheme": "calmly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6FA078",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.calmly",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FBF9F5",
      "translucent": true
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FBF9F5"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Calmly — Mindful Habit & Mood Tracker",
      "shortName": "Calmly",
      "lang": "en",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/",
      "themeColor": "#2C4F45",
      "backgroundColor": "#F8F6F1",
      "description": "Mindful habit, mood, and reflection tracker designed for inner stillness."
    },
    "extra": {
      "eas": {
        "projectId": "bf1c25ed-275a-4fcf-86ed-3ad5f10703e7"
      }
    },
    "owner": "shubbyy",
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Calmly uses your photo library so you can choose a profile picture and attach photos to reflections.",
          "cameraPermission": "Calmly uses your camera so you can take a profile picture and capture moments for your reflections."
        }
      ],
      "expo-video",
      "./plugins/withAppOptimization.js"
    ]
  }
}
